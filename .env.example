# ============================================================
# mall-agent 环境配置模板
# 复制为 .env 后填写：copy .env.example .env
# .env 已被 .gitignore 排除，不会上传；本文件不含任何真实密钥。
# ============================================================

# ---------- LLM（Agent 与评测主用） ----------
# deepseek:  https://api.deepseek.com  模型 deepseek-chat
# qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# ollama:    http://127.0.0.1:11434/v1  模型 qwen2.5:7b（零成本）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 1=关闭 DeepSeek 思考模式（默认），0=开启
LLM_DISABLE_THINKING=1

# 用户模拟器 / judge 可用更便宜的模型（可选，留空则复用主 LLM）
USER_SIM_API_KEY=
USER_SIM_BASE_URL=
USER_SIM_MODEL=

# ---------- 宿主 mall ----------
# 真实后端：http://127.0.0.1:8085 （需 MallPortalApplication 运行）
# Mock 模式：mall_api 会读 mall.sql 种子构建只读内存态
MALL_API_BASE=http://127.0.0.1:8085
MALL_USE_MOCK=true
# 改成你自己机器上 mall.sql 的路径（不要提交真实个人路径）
MALL_SQL_PATH=./path/to/mall.sql

# 测试账号（Mock 模式自动创建；真实模式需提前在 mall 注册）
MALL_TEST_USER=agent_test_user
MALL_TEST_PASSWORD=change_me

# 直连 MySQL 做归属校验时用（可选；不填则走 mock）
MALL_MYSQL_HOST=127.0.0.1
MALL_MYSQL_PORT=3306
MALL_MYSQL_USER=root
MALL_MYSQL_PASSWORD=change_me
MALL_MYSQL_DB=mall

# ---------- RAG-MCP-SERVER ----------
# 改成你自己机器上的路径（不要提交真实个人路径）
RAG_MCP_PYTHON=./path/to/RAG-MCP-SERVER/.venv/Scripts/python.exe
RAG_MCP_MODULE=rag_mcp_server.mcp_server.server
RAG_MCP_CWD=./path/to/RAG-MCP-SERVER
RAG_MCP_SRC=./path/to/RAG-MCP-SERVER/src

# ---------- 评测 ----------
# 单任务最大步数（发散约束上限）
MAX_STEPS=15
DEFAULT_CONTEXT_POLICY=sliding
